# ==============================================================================
# LifeOS Backend Environment Variables Configuration
# Copy this file to .env or use platform environment/secrets manager
# Usage: cp .env.example .env
# ==============================================================================

# ── Server Port Configuration ─────────────────────────────────────────────────
# Port for Spring Boot to listen on (default: 8080, HF Spaces: 7860, local dev: 8080/8000)
SERVER_PORT=8080
PORT=8080
BACKEND_PORT_HOST=8080

# ── Database Configuration ────────────────────────────────────────────────────
# Option 1: Direct Spring Datasource URL (overrides all others)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# Option 2: Neon Cloud Postgres (or other cloud provider with sslmode=require)
NEON_DATASOURCE_URL=
NEON_DATASOURCE_USERNAME=
NEON_DATASOURCE_PASSWORD=

# Option 3: Local Docker PostgreSQL
LOCAL_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos
LOCAL_DATASOURCE_USERNAME=postgres
LOCAL_DATASOURCE_PASSWORD=postgres
DB_PORT_HOST=5432
POSTGRES_DB=lifeos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Encryption (AES-256-GCM 32-byte Base64 encoded key) ───────────────────────
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET_KEY=CHANGE_ME_BASE64_32_BYTES_KEY==
ENC_KEY=

# ── VAPID Web Push Notifications ──────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@lifeos.app

# ── AI Provider & Model Configuration ─────────────────────────────────────────
# Active provider: openai | openrouter | gemini | huggingface
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4o-mini

# Cloud/PaaS overrides (LIFOS_ prefix avoids conflicts on platforms like HuggingFace Spaces)
LIFOS_AI_PROVIDER=
LIFOS_AI_MODEL=

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
LIFOS_OPENAI_API_KEY=

# ── OpenRouter (supports dozens of providers & free models) ────────────────────
OPENROUTER_API_KEY=
LIFOS_OPENROUTER_API_KEY=

# ── Google Gemini (https://aistudio.google.com/app/apikey) ────────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
LIFOS_GEMINI_API_KEY=

# ── Hugging Face (Inference API or custom ZeroGPU Space) ──────────────────────
HF_API_KEY=
HF_INFERENCE_URL=https://api-inference.huggingface.co/v1/chat/completions
LIFOS_HF_API_KEY=
LIFOS_HF_INFERENCE_URL=

# ── Embeddings ────────────────────────────────────────────────────────────────
# Default: text-embedding-3-small (1536 dims)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Dedicated OpenRouter key for embeddings (optional)
OPENROUTER_EMBEDDING_API_KEY=
LIFOS_OPENROUTER_EMBEDDING_API_KEY=

# ── Firebase Admin SDK (Authentication & User Verification) ───────────────────
# Method 1: Path to service account file (relative to backend or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=classpath:firebase-service-account.json

# Method 2: Full raw JSON string as one line
FIREBASE_SERVICE_ACCOUNT_JSON=

# Method 3: Base64-encoded JSON (safest for environments that mangle multiline JSON)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Method 4: Individual fields
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
